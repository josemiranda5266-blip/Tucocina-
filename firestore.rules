rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email == "cristianbravo5266@gmail.com")
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Videos collection
    match /videos/{videoId} {
      // Public can read PUBLISHED videos
      allow get, list: if resource.data.status == "PUBLISHED" || isAdmin();
      // Admin has full control
      allow create, update, delete: if isAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      // Public read access for categories
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == "USER";
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role; // Role modification forbidden
      allow delete: if isAdmin();

      // User favorites subcollection
      match /favorites/{videoId} {
        allow get, list, create, delete: if isOwner(userId);
      }
    }

    // Reports collection
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow get, list, update, delete: if isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow get: if isOwner(adminId);
      allow list, create, update, delete: if isAdmin();
    }
  }
}
