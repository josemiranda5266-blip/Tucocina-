# CociFlash server environment
PORT=3000
NODE_ENV=development

# Public origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

# Firebase Admin / Firestore
FIREBASE_PROJECT_ID=gen-lang-client-0084774429
FIRESTORE_DATABASE_ID=ai-studio-cococina-e9d5af8c-a666-4198-98b5-c1cf52e614ff
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google AdSense (desactivado por defecto; usar solo con cuenta y sitio configurados)
VITE_ADS_ENABLED=false
VITE_ADS_PROVIDER=none
VITE_ADSENSE_PUBLISHER_ID=
ADSENSE_PUBLISHER_ID=

# Google / YouTube
YOUTUBE_API_KEY=
# GEMINI_API_KEY=
# Disabled by default. Enable only during a private admin testing window.
VIDEO_AI_IMPORT_ENABLED=false

# Comma-separated emails explicitly allowed to perform the initial admin bootstrap.
# Example: ADMIN_BOOTSTRAP_EMAILS=cristianbravo5266@gmail.com
