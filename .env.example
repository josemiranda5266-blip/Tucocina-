# Server & Environment Configuration
PORT=3000
NODE_ENV=development

# Optional CORS restriction (If omitted, dynamically permits same-host and preview origins)
# ALLOWED_ORIGINS=https://tu-dominio.com

# Optional Gemini API Key (For administrative metadata suggestions only, system functions fine without it)
# GEMINI_API_KEY=your_gemini_api_key

# Note: Firebase project configuration is loaded automatically from firebase-applet-config.json.
# ADMIN_EMAILS / VITE_ADMIN_EMAILS are OBSOLETE. User roles are governed strictly by Firebase Custom Claims (admin === true).
